{
  "Version": "2012-10-17",
  "Statement": [
    { "Sid": "Dispatch", "Effect": "Allow",
      "Action": ["ssm:SendCommand", "ssm:GetCommandInvocation", "ssm:ListCommandInvocations"],
      "Resource": "*" },
    { "Sid": "Params", "Effect": "Allow",
      "Action": ["ssm:GetParameter", "ssm:GetParameters"],
      "Resource": "arn:aws:ssm:*:ACCOUNT_ID:parameter/carbonpilot/*" },
    { "Sid": "Kms", "Effect": "Allow", "Action": ["kms:Decrypt"], "Resource": "*" },
    { "Sid": "Ec2", "Effect": "Allow",
      "Action": ["ec2:DescribeInstances", "ec2:TerminateInstances"], "Resource": "*" },
    { "Sid": "S3", "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject", "s3:ListBucket"],
      "Resource": [
        "arn:aws:s3:::carbon-pilot-data-ACCOUNT_ID",
        "arn:aws:s3:::carbon-pilot-data-ACCOUNT_ID/*"
      ] }
  ]
}
